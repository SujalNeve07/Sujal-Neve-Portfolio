# ==============================================================================
# Sujal Neve Portfolio - Backend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' or export these environment variables in your deployment environment.
# 2. For Gmail: Generate an "App Password" at https://myaccount.google.com/apppasswords
#    (requires 2-Step Verification enabled).
# 3. DO NOT commit production passwords to version control.
# ==============================================================================

# Server Port
PORT=8080

# Spring Mail / SMTP Server Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sujal.neve07@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# Recipient Address (where inquiries will be delivered)
MAIL_TO=sujal.neve07@gmail.com

# Allowed CORS Origins (comma-separated for dev and production frontend domains)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Rate Limiting Configuration
# Maximum submissions permitted per client IP within the sliding time window
RATE_LIMIT_MAX=5
# Time window in seconds (300 seconds = 5 minutes)
RATE_LIMIT_WINDOW=300
